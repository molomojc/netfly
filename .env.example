# FakeFlix Environment Variables
# Copy to .env and fill in your values

# API Keys
REACT_APP_TMDB_API_KEY=your_tmdb_api_key

# Backend
REACT_APP_API_URL=https://flixcinema.onrender.com

# m3u8 Extractor Microservice (optional - enables direct HLS playback without ads)
REACT_APP_EXTRACTOR_URL=http://localhost:3001
REACT_APP_USE_DIRECT_STREAM=true

# Player engine. Native HLS (hardware decode) is preferred on Android TV /
# Fire TV; hls.js is the automatic fallback. Set to true to force hls.js, or
# append ?engine=hls to the player URL (e.g. /PlayMovie?engine=hls).
# REACT_APP_FORCE_HLS=false